{
  "name": "catalyst-native",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "prebuilt": "run-s -c bin:*",
    "bin:emoji-gen": "tsx ./bin/emoji-gen.ts",
    "bin:license-list": "tsx ./bin/license-list.ts",
    "run:android": "pnpm run prebuilt && expo run:android",
    "run:ios": "pnpm run prebuilt && expo run:ios",
    "build:android:development": "pnpm run prebuilt && eas build --platform android --profile development --local",
    "build:android:preview": "pnpm run prebuilt && eas build --platform android --profile preview --local",
    "build:android:production": "pnpm run prebuilt && eas build --platform android --profile production --local",
    "build:ios:development": "pnpm run prebuilt && eas build --platform ios --profile development --local",
    "build:ios:preview": "pnpm run prebuilt && eas build --platform ios --profile preview --local",
    "build:ios:production": "pnpm run prebuilt && eas build --platform ios --profile production --local",
    "submit:android:preview": "eas submit --platform android --profile preview",
    "submit:android:production": "eas submit --platform android --profile production",
    "submit:ios:preview": "eas submit --platform ios --profile preview",
    "submit:ios:production": "eas submit --platform ios --profile production",
    "lint": "expo lint",
    "expo": "expo"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@likashefqet/react-native-image-zoom": "^4.3.0",
    "@luccasr73/with-rn-image-crop-picker": "^0.1.5",
    "@natsuneko-laboratory/catalyst-sdk": "^0.3.1",
    "@natsuneko-laboratory/react-native-twitter-text": "^0.1.0",
    "@react-native-async-storage/async-storage": "3.0.1",
    "@react-native-async-storage/expo-with-async-storage": "^1.0.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-community/push-notification-ios": "^1.12.0",
    "@react-native-community/slider": "^5.1.2",
    "@react-native-firebase/app": "^23.8.8",
    "@react-native-firebase/messaging": "^23.8.8",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/drawer": "^7.9.4",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.33",
    "@sentry/react-native": "^8.4.0",
    "@shopify/flash-list": "^2.3.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "expo": "~55.0.6",
    "expo-asset": "^55.0.8",
    "expo-build-properties": "^55.0.9",
    "expo-clipboard": "^55.0.8",
    "expo-constants": "~55.0.7",
    "expo-dev-client": "~55.0.16",
    "expo-file-system": "^55.0.10",
    "expo-font": "~55.0.4",
    "expo-haptics": "~55.0.8",
    "expo-image": "~55.0.6",
    "expo-image-picker": "^55.0.12",
    "expo-linking": "~55.0.7",
    "expo-router": "~55.0.5",
    "expo-secure-store": "~55.0.8",
    "expo-splash-screen": "~55.0.10",
    "expo-status-bar": "~55.0.4",
    "expo-symbols": "~55.0.5",
    "expo-system-ui": "~55.0.9",
    "expo-web-browser": "~55.0.9",
    "jotai": "^2.18.1",
    "lucide-react-native": "^0.577.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-image-crop-picker": "^0.51.1",
    "react-native-reanimated": "~4.2.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.24.0",
    "react-native-toast-message": "^2.3.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "rehype-raw": "^7.0.0",
    "rehype-react": "^8.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "twitter-text": "^3.1.0",
    "unified": "^11.0.5",
    "uniwind": "^1.5.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@callstack/licenses": "^0.3.1",
    "@types/react": "latest",
    "@types/twitter-text": "^3.1.10",
    "babel-preset-expo": "^55.0.10",
    "eas-cli": "^18.1.0",
    "eas-cli-local-build-plugin": "^18.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~55.0.0",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.40.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "unrs-resolver"
    ],
    "ignoredBuiltDependencies": [
      "core-js",
      "dtrace-provider",
      "esbuild"
    ],
    "patchedDependencies": {
      "@expo/cli": "patches/@expo__cli.patch",
      "@likashefqet/react-native-image-zoom": "patches/@likashefqet__react-native-image-zoom.patch",
      "react-native": "patches/react-native.patch"
    }
  }
}
